# Rocky Linux 9 with systemd and sshd, a managed host for this circuit's
# end-to-end tests, built like Conn3x's own rocky10 test image.
FROM docker.io/rockylinux/rockylinux:9-ubi-init

RUN dnf -y install openssh-server sudo policycoreutils \
 && dnf makecache \
 && ssh-keygen -A \
 && systemctl enable sshd \
 && mkdir -p -m 700 /root/.ssh

EXPOSE 22
CMD ["/sbin/init"]
